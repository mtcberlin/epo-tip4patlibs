{
  "_comment": "MCP configuration for query-mcp server running in VS Code devcontainer",
  "_setup": [
    "1. Open mcp-server folder in VS Code",
    "2. Click 'Reopen in Container' when prompted (requires Dev Containers extension)",
    "3. In container terminal: query-mcp --sse --port 8080",
    "4. Copy this file to .mcp.json in project root",
    "5. Reconnect Claude Code: /mcp"
  ],
  "mcpServers": {
    "query-mcp": {
      "type": "sse",
      "url": "http://localhost:8080/sse"
    }
  }
}
