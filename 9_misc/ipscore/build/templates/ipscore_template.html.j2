        +finField('fin_direct','{{ ui.fin_page.direct.label|jsq }}','{{ ui.fin_page.direct.unit|jsq }}','{{ ui.fin_page.direct.help|jsq }}','number','{{ ui.fin_page.direct.default|jsq }}')
