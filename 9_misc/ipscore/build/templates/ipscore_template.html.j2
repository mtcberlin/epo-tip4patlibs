        +finField('fin_depreciation','{{ ui.fin_page.depreciation.label|jsq }}','{{ ui.fin_page.depreciation.unit|jsq }}','{{ ui.fin_page.depreciation.help|jsq }}','number','{{ ui.fin_page.depreciation.default|jsq }}')
