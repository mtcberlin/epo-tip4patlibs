function finField(id, label, unit, helpText, type, defaultVal){
  return '<div class="fin-field">'
    +'<div class="fin-label">'+label+' <span>('+unit+')</span></div>'
    +'<input class="fin-input" type="'+type+'" id="'+id+'" placeholder="'+defaultVal+'" step="any">'
    +'<button class="help-btn" onclick="toggleHelp(\'fin_'+id+'\')" type="button" style="margin-top:6px">&#9432; {{ ui.fin_help_btn_label|jsq }}</button>'
    +'<div class="help-panel" id="help_fin_'+id+'">'+helpText+'</div>'
    +'</div>';
}

function buildStepBar(){
  var bar=document.getElementById('step-bar');
  var names={{ ui.step_names|tojson }};
  var html='';
  for(var i=0;i<NPAGE;i++){
    if(i>0) html+='<div class="step-sep" id="sep-'+(i-1)+'"></div>';
    html+='<div class="step"><div class="step-dot'+(i===0?' active':'')+'\" id="dot-'+i+'" onclick="goToPage('+i+')">'+(i+1)+'</div>'
      +'<span class="step-label">'+names[i]+'</span></div>';
  }
  bar.innerHTML=html;
}

{% if demo %}
function fillDemo(){
  document.getElementById('pat-name').value={{ demo.patent.name|tojson }};
  document.getElementById('pat-num').value={{ demo.patent.num|tojson }};
  document.getElementById('pat-company').value={{ demo.patent.company|tojson }};
  document.getElementById('pat-sector').value={{ demo.patent.sector|tojson }};
  document.getElementById('pat-date').value={{ demo.patent.date|tojson }};
  document.getElementById('pat-desc').value={{ demo.patent.desc|tojson }};

  var scores={{ demo.scores|tojson }};
  Object.keys(scores).forEach(function(qid){
    var val=scores[qid];
    var radio=document.querySelector('input[name="q_'+qid+'"][value="'+val+'"]');
    if(radio){radio.checked=true; onRadio(qid,val);}
  });

  document.getElementById('fin_turnover').value={{ demo.financials.turnover|jsq }};
  document.getElementById('fin_direct').value={{ demo.financials.direct|jsq }};
  document.getElementById('fin_indirect').value={{ demo.financials.indirect|jsq }};
  document.getElementById('fin_depreciation').value={{ demo.financials.depreciation|jsq }};
  document.getElementById('fin_deprecPeriod').value={{ demo.financials.deprecPeriod|jsq }};
  document.getElementById('fin_sectorShare').value={{ demo.financials.sectorShare|jsq }};
  document.getElementById('fin_discount').value={{ demo.financials.discount|jsq }};
  updateNetResult();

  var dots=document.querySelectorAll('.step-dot');
  var seps=document.querySelectorAll('.step-sep');
  for(var i=0;i<NPAGE-1;i++){
    if(dots[i]){dots[i].classList.remove('active');dots[i].classList.add('done');}
    if(seps[i]) seps[i].classList.add('done');
  }
  goToPage(7);
}
{% endif %}

document.addEventListener('DOMContentLoaded', function(){
  buildPages();
  buildStepBar();
  updateNavInfo();
  {% if demo %}fillDemo();{% endif %}
});
</script>
