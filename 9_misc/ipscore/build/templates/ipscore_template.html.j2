<!DOCTYPE html>
<html lang="{{ ui.html_lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{% if demo %}{{ ui.title_demo }}{% else %}{{ ui.title_blank }}{% endif %}</title>
<style>
:root{--navy:#1a2744;--blue:#2563eb;--orange:#f97316;--light:#f8fafc;--border:#e2e8f0;--green:#16a34a;--red:#dc2626;--yellow:#d97706}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Arial,sans-serif;background:#f1f5f9;color:#1e293b;min-height:100vh}
header{background:var(--navy);color:#fff;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.3)}
header .brand{font-size:1.15rem;font-weight:700;letter-spacing:.5px}
header .sub{font-size:.8rem;opacity:.7;margin-top:2px}
header .badge{background:var(--orange);color:#fff;font-size:.7rem;font-weight:700;padding:3px 9px;border-radius:20px;letter-spacing:.5px}
.step-bar{background:#fff;border-bottom:1px solid var(--border);padding:10px 28px;display:flex;align-items:center;gap:6px;overflow-x:auto}
.step{display:flex;align-items:center;gap:6px;flex-shrink:0}
.step-dot{width:28px;height:28px;border-radius:50%;border:2px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;color:#94a3b8;cursor:pointer;transition:all .2s}
.step-dot.active{background:var(--blue);border-color:var(--blue);color:#fff}
.step-dot.done{background:var(--navy);border-color:var(--navy);color:#fff}
.step-label{font-size:.68rem;color:#64748b;white-space:nowrap}
.step-sep{width:20px;height:2px;background:var(--border);flex-shrink:0}
.step-sep.done{background:var(--navy)}
.page{display:none;padding:24px 28px 100px;max-width:860px;margin:0 auto}
.page.active{display:block}
.page-title{font-size:1.35rem;font-weight:800;color:var(--navy);margin-bottom:4px}
.page-desc{font-size:.88rem;color:#475569;margin-bottom:20px;line-height:1.5}
.sec-header{background:var(--navy);color:#fff;border-radius:8px 8px 0 0;padding:12px 18px;display:flex;align-items:center;gap:10px;margin-bottom:0}
.sec-header .sec-badge{background:var(--orange);color:#fff;font-size:.75rem;font-weight:700;padding:2px 10px;border-radius:12px}
.sec-header h2{font-size:1rem;font-weight:700}
.sec-progress{background:#e2e8f0;height:6px;border-radius:0}
.sec-progress-fill{height:6px;background:var(--orange);transition:width .3s}
.sec-score-bar{background:#f8fafc;border:1px solid var(--border);border-top:none;padding:8px 18px;display:flex;justify-content:flex-end;align-items:center;gap:8px;font-size:.82rem;color:#475569;font-weight:600;border-radius:0 0 0 0}
.q-card{background:#fff;border:1px solid var(--border);border-top:none;padding:18px 18px 12px}
.q-card:last-child{border-radius:0 0 8px 8px;margin-bottom:20px}
.q-num{display:inline-block;background:var(--blue);color:#fff;font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:10px;margin-bottom:8px}
.q-text{font-size:.92rem;font-weight:600;color:var(--navy);margin-bottom:10px}
.radio-group{display:flex;flex-direction:column;gap:6px;margin-bottom:8px}
.radio-opt{display:flex;align-items:flex-start;gap:8px;cursor:pointer;padding:6px 10px;border-radius:6px;border:1.5px solid var(--border);transition:background .15s,border-color .15s}
.radio-opt:hover{background:#f0f6ff;border-color:#93c5fd}
.radio-opt input{margin-top:2px;accent-color:var(--blue);width:16px;height:16px;flex-shrink:0}
.radio-opt .opt-num{font-size:.75rem;font-weight:700;color:var(--orange);min-width:16px}
.radio-opt .opt-text{font-size:.82rem;color:#374151;line-height:1.4}
.radio-opt.selected{background:#eff6ff;border-color:var(--blue)}
.help-btn{background:none;border:1px solid var(--border);color:#64748b;font-size:.72rem;padding:3px 10px;border-radius:12px;cursor:pointer;display:flex;align-items:center;gap:4px;margin-top:4px;transition:all .15s}
.help-btn:hover{background:#f0f6ff;border-color:var(--blue);color:var(--blue)}
.help-panel{display:none;background:#fffbeb;border:1px solid #fde68a;border-radius:6px;padding:10px 14px;margin-top:8px;font-size:.8rem;color:#92400e;line-height:1.55}
.help-panel.open{display:block}
.help-panel strong{color:#78350f}
.fin-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:600px){.fin-grid{grid-template-columns:1fr}}
.fin-field{background:#fff;border:1px solid var(--border);border-radius:8px;padding:14px 16px}
.fin-label{font-size:.8rem;font-weight:700;color:var(--navy);margin-bottom:6px;display:flex;align-items:center;gap:6px}
.fin-label span{font-size:.7rem;color:#64748b;font-weight:400}
.fin-input{width:100%;border:1.5px solid var(--border);border-radius:6px;padding:8px 12px;font-size:.92rem;color:#1e293b;transition:border-color .15s}
.fin-input:focus{outline:none;border-color:var(--blue)}
.fin-input.readonly{background:#f1f5f9;color:#475569}
.nav-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);padding:12px 28px;display:flex;justify-content:space-between;align-items:center;z-index:90}
.nav-info{font-size:.8rem;color:#64748b;font-weight:600}
.btn{padding:9px 24px;border-radius:8px;font-size:.88rem;font-weight:700;cursor:pointer;border:none;transition:all .15s}
.btn-prev{background:#f1f5f9;color:var(--navy);border:1.5px solid var(--border)}
.btn-prev:hover{background:#e2e8f0}
.btn-next{background:var(--blue);color:#fff}
.btn-next:hover{background:#1d4ed8}
.btn-print{background:var(--orange);color:#fff}
.btn-print:hover{background:#ea580c}
.results-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
@media(max-width:640px){.results-grid{grid-template-columns:1fr}}
.score-card{background:var(--navy);color:#fff;border-radius:10px;padding:22px;text-align:center}
.score-big{font-size:3rem;font-weight:800;color:var(--orange)}
.score-sub{font-size:.85rem;opacity:.8;margin-top:4px}
.score-interp{font-size:.82rem;background:rgba(255,255,255,.12);border-radius:6px;padding:8px 12px;margin-top:12px;line-height:1.4}
.radar-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:16px;display:flex;justify-content:center;align-items:center}
.sec-bars{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:20px}
.sec-bars h3{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:14px}
.bar-row{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.bar-name{font-size:.8rem;color:#374151;width:140px;flex-shrink:0}
.bar-track{flex:1;height:14px;background:#e2e8f0;border-radius:7px;overflow:hidden}
.bar-fill{height:14px;border-radius:7px;transition:width .4s}
.bar-val{font-size:.78rem;font-weight:700;color:var(--navy);width:60px;text-align:right;flex-shrink:0}
.risk-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:20px}
.risk-card h3{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:14px}
.risk-row{margin-bottom:14px}
.risk-label{font-size:.8rem;font-weight:600;color:#374151;margin-bottom:6px;display:flex;justify-content:space-between}
.van-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:20px;overflow-x:auto}
.van-card h3{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:14px}
.van-table{width:100%;border-collapse:collapse;font-size:.75rem}
.van-table th{background:var(--navy);color:#fff;padding:6px 8px;text-align:right;white-space:nowrap}
.van-table th:first-child{text-align:left}
.van-table td{padding:5px 8px;border-bottom:1px solid #f1f5f9;text-align:right}
.van-table td:first-child{text-align:left;font-weight:600;color:var(--navy)}
.van-table tr:hover td{background:#f8fafc}
.van-table .total-row td{font-weight:700;background:#f0f6ff;color:var(--navy);border-top:2px solid var(--blue)}
.van-highlight{color:var(--blue);font-weight:700}
.steps-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:20px}
.steps-card h3{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:12px}
.step-item{display:flex;gap:12px;margin-bottom:12px;align-items:flex-start}
.step-icon{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:#fff;flex-shrink:0}
.step-icon.info{background:var(--blue)}
.step-icon.warn{background:var(--yellow)}
.step-icon.good{background:var(--green)}
.step-text{font-size:.82rem;color:#374151;line-height:1.5}
.intro-hero{background:linear-gradient(135deg,var(--navy) 0%,#2d4a8a 100%);color:#fff;border-radius:12px;padding:28px;margin-bottom:24px}
.intro-hero h1{font-size:1.5rem;font-weight:800;margin-bottom:8px}
.intro-hero p{font-size:.88rem;opacity:.85;line-height:1.6;margin-bottom:16px}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:600px){.info-grid{grid-template-columns:1fr}}
.info-field{background:#fff;border:1px solid var(--border);border-radius:8px;padding:12px 14px}
.info-field label{display:block;font-size:.78rem;font-weight:700;color:var(--navy);margin-bottom:5px}
.info-field input,.info-field textarea{width:100%;border:1.5px solid var(--border);border-radius:6px;padding:7px 11px;font-size:.88rem;color:#1e293b;font-family:inherit}
.info-field input:focus,.info-field textarea:focus{outline:none;border-color:var(--blue)}
.features-list{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:16px}
@media(max-width:600px){.features-list{grid-template-columns:1fr}}
.feat{background:rgba(255,255,255,.12);border-radius:8px;padding:12px;text-align:center;font-size:.78rem}
.feat .feat-icon{font-size:1.4rem;margin-bottom:4px}
@media print{
  header,#step-bar,.nav-bar,#help-toggle-all{display:none!important}
  .page{display:block!important;padding:10px;page-break-after:always}
  .page:last-child{page-break-after:avoid}
  .help-panel{display:none!important}
  body{background:#fff}
}
</style>
</head>
<body>
<header>
  <div><div class="brand">{{ ui.brand }}</div><div class="sub">{{ ui.sub }}</div></div>
  <div class="badge"{% if demo %} style="background:#f59e0b"{% endif %}>{% if demo %}{{ ui.badge_demo }}{% else %}{{ ui.badge_blank }}{% endif %}</div>
</header>
<div class="step-bar" id="step-bar"></div>
{% if demo %}<div id="demo-banner" style="background:#fffbeb;border-bottom:2px solid #f59e0b;padding:8px 28px;display:flex;align-items:center;gap:12px;font-size:.82rem;color:#92400e">
  <span style="font-size:1.1rem">&#9888;</span>
  <span><strong>{{ ui.demo_banner_lead }}</strong> {{ ui.demo_banner_desc_template.format(patent_short=demo.banner_short_name, company=demo.patent.company) }}</span>
</div>{% endif %}
<div id="pages"></div>
<div class="nav-bar">
  <button class="btn btn-prev" id="btn-prev" onclick="navigate(-1)">&#8592; {{ ui.nav_prev }}</button>
  <div class="nav-info" id="nav-info"></div>
  <button class="btn btn-next" id="btn-next" onclick="navigate(1)">{{ ui.nav_next }} &#8594;</button>
</div>
<script>
var cur = 0;
var NPAGE = 8;

var STD5 = {{ std5_json }};

var QS = {{ qs_json }};


var SEC_ORDER = ['A','B','C','D','E'];
var SEC_NAMES = {{ sec_names_json }};
var SEC_MAX = {A:40,B:45,C:45,D:30,E:40};
var OEK_QUESTIONS = ['B5','C2','C3','C6','D1','D2','D3','D4'];

function getScores() {
  var s = {};
  QS.forEach(function(q) {
    var sel = document.querySelector('input[name="q_'+q.id+'"]:checked');
    s[q.id] = sel ? parseInt(sel.value) : 0;
  });
  return s;
}

function getOEK(scores) {
  var o = {};
  QS.forEach(function(q) {
    if (q.oek) { o[q.id] = q.oek[scores[q.id]-1] !== undefined ? q.oek[scores[q.id]-1] : 0; }
  });
  return o;
}

function getSecScore(sec, scores) {
  var tot = 0;
  QS.filter(function(q){return q.sec===sec;}).forEach(function(q){tot+=scores[q.id]||0;});
  return tot;
}

function calcRiskOpp(scores) {
  var riskSum = 0, riskMax = 0;
  var oppSum = 0, oppMax = 0;
  QS.forEach(function(q) {
    var v = scores[q.id] || 0;
    if (q.risk) { riskSum += -(5-v)/4; riskMax += 1; }
    if (q.opp) { oppSum += (v-1)/4; oppMax += 1; }
  });
  return {
    risk: riskMax > 0 ? Math.abs(riskSum)/riskMax : 0,
    opp: oppMax > 0 ? oppSum/oppMax : 0
  };
}

function getFin() {
  function v(id) { return parseFloat(document.getElementById(id).value)||0; }
  return {
    turnover: v('fin_turnover'),
    directCosts: v('fin_direct'),
    indirectCosts: v('fin_indirect'),
    depreciation: v('fin_depreciation'),
    deprecPeriod: v('fin_deprecPeriod')||5,
    sectorShare: v('fin_sectorShare'),
    discountRate: v('fin_discount')
  };
}

function calcVAN(fin, oek) {
  if (!fin.turnover || !fin.sectorShare) return {van:0, rows:[]};
  var BT = fin.turnover;
  var DC = fin.directCosts;
  var IC = fin.indirectCosts;
  var DP = fin.depreciation;
  var depPeriod = fin.deprecPeriod;
  var S = fin.sectorShare / 100;
  var discount = (fin.discountRate||10) / 100;
  var shareCosts = BT > 0 ? (DC+IC)/BT : 0;
  var shareDeprec_pct = BT > 0 ? DP/BT*100 : 0;
  var invIndex = BT > 0 ? depPeriod*DP/BT : 0;
  var T = oek['B5'] !== undefined ? oek['B5'] : 2;
  var g = oek['C2'] !== undefined ? oek['C2'] : 0.025;
  var L = oek['C3'] !== undefined ? oek['C3'] : 2;
  var et = oek['C6'] !== undefined ? oek['C6'] : 0.04;
  var D1 = oek['D1'] !== undefined ? oek['D1'] : 0.5;
  var D2 = oek['D2'] !== undefined ? oek['D2'] : 0.08;
  var D3 = oek['D3'] !== undefined ? oek['D3'] : 1.0;
  var D4 = oek['D4'] !== undefined ? oek['D4'] : 1.0;

  function fracYear(y) {
    if (y <= T) return 0;
    if (y-T < 1) return y-T;
    if (y <= T+L) return 1;
    if (y-T-L < 1) return 1-(y-T-L);
    return 0;
  }

  var rev = [0];
  for (var y=1; y<=10; y++) {
    var frac = fracYear(y);
    rev.push(frac * et * Math.pow(1+g,y-1) * S * Math.pow(1+g,y) * 100);
  }

  var yFirst = 0;
  for (var y=1; y<=10; y++) { if (rev[y]>0) { yFirst=y; break; } }

  // Matches Excel 'Financial calculations' rows 98-121: sum revenue over every
  // year y with y>T and y<=T+1+depPeriod (always depPeriod+1 calendar-year
  // slots, not depPeriod), then divide by depPeriod.
  var sumRevNext = 0;
  for (var y=1; y<=10; y++) { if (y>T && y<=T+1+depPeriod) sumRevNext += rev[y]; }
  var avgRev = depPeriod>0 ? sumRevNext/depPeriod : 0;

  var rows = [], van = 0;
  for (var y=1; y<=10; y++) {
    var revenue = rev[y];
    var frac = fracYear(y);
    var devCost = (y<=T) ? D2*S*100 : 0;
    var costs = revenue*D3*shareCosts + devCost;
    var investments = (y===yFirst && yFirst>0) ? avgRev*D4*invIndex : 0;
    var invReduction = (y===yFirst && yFirst>0) ? depPeriod*shareDeprec_pct*(1-D4)*S*Math.pow(1+g,y) : 0;
    var regained = frac*(1-shareCosts)*(1-D1)*S*Math.pow(1+g,y)*100;
    var efficiency = frac*shareCosts*(1-D3)*S*Math.pow(1+g,y)*100;
    var liquidity = revenue - costs - investments + regained + efficiency + invReduction;
    var pv = liquidity * BT/100 / Math.pow(1+discount,y);
    van += pv;
    rows.push({y:y,revenue:revenue,costs:costs,investments:investments,invReduction:invReduction,regained:regained,efficiency:efficiency,liquidity:liquidity,pv:pv});
  }
  return {van:van, rows:rows};
}

function drawRadar(canvas, secScores) {
  var ctx = canvas.getContext('2d');
  canvas.width = 340; canvas.height = 300;
  ctx.clearRect(0,0,canvas.width,canvas.height);
  var cx=170, cy=155, R=100;
  var n=5;
  var labels={{ ui.radar_labels|tojson }};
  var maxes=[40,45,45,30,40];
  var norms=secScores.map(function(s,i){return maxes[i]>0?s/maxes[i]:0;});

  ctx.strokeStyle='#e2e8f0'; ctx.lineWidth=1;
  for(var lev=1;lev<=5;lev++){
    var r=R*lev/5;
    ctx.beginPath();
    for(var i=0;i<n;i++){
      var ang=2*Math.PI*i/n-Math.PI/2;
      var x=cx+r*Math.cos(ang), yy=cy+r*Math.sin(ang);
      i===0?ctx.moveTo(x,yy):ctx.lineTo(x,yy);
    }
    ctx.closePath(); ctx.stroke();
  }
  ctx.strokeStyle='#cbd5e1'; ctx.lineWidth=1;
  for(var i=0;i<n;i++){
    var ang=2*Math.PI*i/n-Math.PI/2;
    ctx.beginPath(); ctx.moveTo(cx,cy);
    ctx.lineTo(cx+R*Math.cos(ang),cy+R*Math.sin(ang)); ctx.stroke();
  }
  ctx.beginPath();
  for(var i=0;i<n;i++){
    var ang=2*Math.PI*i/n-Math.PI/2;
    var r=R*norms[i];
    var x=cx+r*Math.cos(ang), yy=cy+r*Math.sin(ang);
    i===0?ctx.moveTo(x,yy):ctx.lineTo(x,yy);
  }
  ctx.closePath();
  ctx.fillStyle='rgba(37,99,235,0.2)'; ctx.fill();
  ctx.strokeStyle='#2563eb'; ctx.lineWidth=2.5; ctx.stroke();
  for(var i=0;i<n;i++){
    var ang=2*Math.PI*i/n-Math.PI/2;
    var r=R*norms[i];
    var x=cx+r*Math.cos(ang), yy=cy+r*Math.sin(ang);
    ctx.beginPath(); ctx.arc(x,yy,5,0,2*Math.PI);
    ctx.fillStyle='#2563eb'; ctx.fill();
  }
  ctx.textAlign='center'; ctx.fillStyle='#1a2744';
  for(var i=0;i<n;i++){
    var ang=2*Math.PI*i/n-Math.PI/2;
    var lx=cx+(R+28)*Math.cos(ang), ly=cy+(R+28)*Math.sin(ang);
    ctx.font='bold 10px Arial'; ctx.fillStyle='#1a2744';
    ctx.fillText(labels[i],lx,ly);
    ctx.font='10px Arial'; ctx.fillStyle='#2563eb';
    ctx.fillText(secScores[i]+'/'+maxes[i],lx,ly+13);
  }
}

function fmt(n){
  if(typeof n!=='number') return '—';
  if(Math.abs(n)<1) return n.toFixed(2);
  return n.toLocaleString('{{ ui.locale|jsq }}',{maximumFractionDigits:0});
}
function fmtEur(n){ return n.toLocaleString('{{ ui.locale|jsq }}',{style:'currency',currency:'EUR',maximumFractionDigits:0}); }
function fmtPct(n){ return (n*100).toFixed(1)+'%'; }

function updateResults() {
  var scores = getScores();
  var oek = getOEK(scores);
  var fin = getFin();
  var ro = calcRiskOpp(scores);
  var van = calcVAN(fin, oek);

  var total=0, secScores=[];
  SEC_ORDER.forEach(function(sec){
    var ss=getSecScore(sec,scores); secScores.push(ss); total+=ss;
  });
  var pct = Math.round(total/200*100);

  var interpText, interpColor;
  if(pct<=40){interpText='{{ ui.interp[0].text|jsq }}';interpColor='var(--red)';}
  else if(pct<=60){interpText='{{ ui.interp[1].text|jsq }}';interpColor='var(--yellow)';}
  else if(pct<=75){interpText='{{ ui.interp[2].text|jsq }}';interpColor='#16a34a';}
  else{interpText='{{ ui.interp[3].text|jsq }}';interpColor='#15803d';}

  document.getElementById('r-total').textContent=total+'/200';
  document.getElementById('r-pct').textContent=pct+'%';
  document.getElementById('r-interp').textContent=interpText;
  document.getElementById('r-interp').style.background = pct>60?'rgba(22,163,74,.15)':'rgba(217,119,6,.15)';

  var riskPct=Math.round(ro.risk*100), oppPct=Math.round(ro.opp*100);
  document.getElementById('r-risk-bar').style.width=riskPct+'%';
  document.getElementById('r-risk-bar').style.background=riskPct>60?'var(--red)':riskPct>30?'var(--yellow)':'var(--green)';
  document.getElementById('r-risk-val').textContent=riskPct+'%';
  document.getElementById('r-opp-bar').style.width=oppPct+'%';
  document.getElementById('r-opp-val').textContent=oppPct+'%';

  SEC_ORDER.forEach(function(sec,i){
    var ss=secScores[i], mx=SEC_MAX[sec], p=Math.round(ss/mx*100);
    var bar=document.getElementById('bar-'+sec);
    if(bar){
      bar.style.width=p+'%';
      bar.style.background=p>=70?'var(--green)':p>=50?'var(--yellow)':'var(--red)';
    }
    var val=document.getElementById('barval-'+sec);
    if(val) val.textContent=ss+'/'+mx+' ('+p+'%)';
  });

  var canvas=document.getElementById('radar-canvas');
  if(canvas) drawRadar(canvas, secScores);

  if(fin.turnover>0){
    var tbody=document.getElementById('van-tbody');
    if(tbody){
      var html='';
      van.rows.forEach(function(r){
        var hasData=r.liquidity!==0;
        html+='<tr>'
          +'<td>{{ ui.year_label|jsq }} '+r.y+'</td>'
          +'<td>'+(hasData?fmtEur(r.revenue*fin.turnover/100):'—')+'</td>'
          +'<td>'+(hasData?fmtEur(r.costs*fin.turnover/100):'—')+'</td>'
          +'<td>'+(r.regained?fmtEur(r.regained*fin.turnover/100):'—')+'</td>'
          +'<td>'+(r.invReduction||r.investments?fmtEur((r.invReduction-r.investments)*fin.turnover/100):'—')+'</td>'
          +'<td style="font-weight:600;color:'+(r.liquidity>=0?'var(--green)':'var(--red)')+'">'+(hasData||r.costs?fmtEur(r.liquidity*fin.turnover/100):'—')+'</td>'
          +'<td class="van-highlight">'+(hasData||r.pv?fmtEur(r.pv):'—')+'</td>'
          +'</tr>';
      });
      tbody.innerHTML=html;
    }
    document.getElementById('van-total').textContent=fmtEur(van.van);
    document.getElementById('van-sign').textContent=van.van>=0?'{{ ui.van_sign_pos|jsq }}':'{{ ui.van_sign_neg|jsq }}';
    document.getElementById('van-sign').style.color=van.van>=0?'var(--green)':'var(--red)';
  }

  var steps='', nm=document.getElementById('pat-name')?document.getElementById('pat-name').value:'';
  if(pct<50) steps+='<div class="step-item"><div class="step-icon warn">!</div><div class="step-text"><strong>{{ ui.low_ipscore_label|jsq }} ('+pct+'%):</strong> {{ ui.low_ipscore_text|jsq }}</div></div>';
  SEC_ORDER.forEach(function(sec,i){
    var p=Math.round(secScores[i]/SEC_MAX[sec]*100);
    if(p<50) steps+='<div class="step-item"><div class="step-icon warn">&#9650;</div><div class="step-text"><strong>{{ ui.section_label|jsq }} '+sec+' ('+p+'%):</strong> '+getSuggestion(sec)+'</div></div>';
  });
  if(riskPct>60) steps+='<div class="step-item"><div class="step-icon warn">&#9888;</div><div class="step-text"><strong>{{ ui.risk_label|jsq }} ('+riskPct+'%):</strong> {{ ui.risk_text|jsq }}</div></div>';
  if(oppPct>70) steps+='<div class="step-item"><div class="step-icon good">&#10003;</div><div class="step-text"><strong>{{ ui.opp_label|jsq }} ('+oppPct+'%):</strong> {{ ui.opp_text|jsq }}</div></div>';
  if(fin.turnover>0 && van.van>0) steps+='<div class="step-item"><div class="step-icon good">&euro;</div><div class="step-text"><strong>{{ ui.npv_positive_label|jsq }} ('+fmtEur(van.van)+'):</strong> {{ ui.npv_positive_text|jsq }}</div></div>';
  if(fin.turnover>0 && van.van<0) steps+='<div class="step-item"><div class="step-icon warn">&euro;</div><div class="step-text"><strong>{{ ui.npv_negative_label|jsq }}:</strong> {{ ui.npv_negative_text|jsq }}</div></div>';
  if(!steps) steps='<div class="step-item"><div class="step-icon good">&#10003;</div><div class="step-text">{{ ui.solid_portfolio_text|jsq }}</div></div>';
  document.getElementById('next-steps').innerHTML=steps;
}

function getSuggestion(sec){
  var s={{ action_plan_json }};
  return s[sec]||{{ ui.action_plan_fallback|tojson }};
}

function toggleHelp(id){
  var el=document.getElementById('help_'+id);
  if(el) el.classList.toggle('open');
}

function updateNavInfo(){
  var pageNames={{ ui.page_names_nav|tojson }};
  document.getElementById('nav-info').textContent='{{ ui.nav_step_label|default('Step')|jsq }} '+(cur+1)+' {{ ui.nav_of_label|default('of')|jsq }} '+NPAGE+' — '+pageNames[cur];
  document.getElementById('btn-prev').style.display=cur===0?'none':'';
  if(cur===NPAGE-1){
    document.getElementById('btn-next').style.display='none';
    if(!document.getElementById('btn-print2')){
      var pb=document.createElement('button');
      pb.className='btn btn-print'; pb.id='btn-print2';
      pb.textContent='{{ ui.print_btn2_text|jsq }}';
      pb.onclick=function(){window.print();};
      document.querySelector('.nav-bar').appendChild(pb);
    }
  } else {
    document.getElementById('btn-next').style.display='';
    var pb2=document.getElementById('btn-print2');
    if(pb2) pb2.remove();
  }
}

function navigate(dir){
  var pages=document.querySelectorAll('.page');
  var dots=document.querySelectorAll('.step-dot');
  var seps=document.querySelectorAll('.step-sep');
  pages[cur].classList.remove('active');
  dots[cur].classList.remove('active');
  dots[cur].classList.add('done');
  if(seps[cur]) seps[cur].classList.add('done');
  cur=Math.max(0,Math.min(NPAGE-1,cur+dir));
  pages[cur].classList.add('active');
  dots[cur].classList.remove('done');
  dots[cur].classList.add('active');
  updateNavInfo();
  if(cur===NPAGE-1) updateResults();
  window.scrollTo(0,0);
}

function goToPage(p){
  if(p<0||p>=NPAGE) return;
  var pages=document.querySelectorAll('.page');
  var dots=document.querySelectorAll('.step-dot');
  pages[cur].classList.remove('active');
  dots[cur].classList.remove('active');
  if(p<cur) dots[cur].classList.remove('done');
  cur=p;
  pages[cur].classList.add('active');
  dots[cur].classList.remove('done');
  dots[cur].classList.add('active');
  updateNavInfo();
  if(cur===NPAGE-1) updateResults();
  window.scrollTo(0,0);
}

function buildSection(sec, pageEl) {
  var qs=QS.filter(function(q){return q.sec===sec;});
  var maxPts=SEC_MAX[sec];
  var html='<div class="sec-header"><span class="sec-badge">'+sec+'</span><h2>'+SEC_NAMES[sec]+'</h2></div>'
    +'<div class="sec-progress"><div class="sec-progress-fill" id="prog-'+sec+'" style="width:0%"></div></div>'
    +'<div class="sec-score-bar">{{ ui.score_label|default('Punteggio')|jsq }}: <strong id="sscore-'+sec+'">0</strong> / '+maxPts+'</div>';
  qs.forEach(function(q,idx){
    html+='<div class="q-card">'
      +'<span class="q-num">'+q.id+'</span>'
      +'<div class="q-text">'+q.t+'</div>'
      +'<div class="radio-group">';
    q.opts.forEach(function(opt,oi){
      html+='<label class="radio-opt" id="lbl_'+q.id+'_'+(oi+1)+'">'
        +'<input type="radio" name="q_'+q.id+'" value="'+(oi+1)+'" onchange="onRadio(\''+q.id+'\','+(oi+1)+')">'
        +'<span class="opt-num">'+(oi+1)+'</span>'
        +'<span class="opt-text">'+opt+'</span>'
        +'</label>';
    });
    html+='</div>';
    html+='<button class="help-btn" onclick="toggleHelp(\''+q.id+'\')" type="button">&#9432; {{ ui.help_btn_label|jsq }}</button>';
    html+='<div class="help-panel" id="help_'+q.id+'">'+q.h+'</div>';
    html+='</div>';
  });
  pageEl.innerHTML=html;
}

function onRadio(qid, val){
  for(var i=1;i<=5;i++){
    var lbl=document.getElementById('lbl_'+qid+'_'+i);
    if(lbl) lbl.classList.toggle('selected',i===val);
  }
  var q=QS.find(function(x){return x.id===qid;});
  if(!q) return;
  var sec=q.sec;
  var scores=getScores();
  var ss=getSecScore(sec,scores);
  var mx=SEC_MAX[sec];
  var prog=document.getElementById('prog-'+sec);
  if(prog) prog.style.width=Math.round(ss/mx*100)+'%';
  var ssc=document.getElementById('sscore-'+sec);
  if(ssc) ssc.textContent=ss;
}

function updateNetResult(){
  var t=parseFloat(document.getElementById('fin_turnover').value)||0;
  var d=parseFloat(document.getElementById('fin_direct').value)||0;
  var ic=parseFloat(document.getElementById('fin_indirect').value)||0;
  var dep=parseFloat(document.getElementById('fin_depreciation').value)||0;
  var net=t-d-ic-dep;
  var el=document.getElementById('fin_net');
  if(el){ el.value=net!==0?Math.round(net).toLocaleString('{{ ui.locale|jsq }}'):''; }
}

