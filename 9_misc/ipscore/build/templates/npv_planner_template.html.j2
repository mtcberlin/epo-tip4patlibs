    <div class="qual-result-card" id="qual-result"></div>
    <div class="actions-card" id="actions-card">
      <h3>{{ ui.page5.actions_title|jsq }}</h3>
      <div id="actions-list"></div>
    </div>
    <div style="text-align:center;margin:20px 0">
      <button class="btn btn-print" onclick="window.print()">{{ ui.page5.print_btn_text|jsq }}</button>
    </div>
  `;
  pagesDiv.appendChild(p5);
}

var PARAM_TIPS = {{ param_tips_json }};


function updateResults(){
  readSetup();
  var npv=calcNPV();
  var tgt=inputs.bt>0?(inputs.bt*inputs.targetPct/100):0;
  var pct=tgt>0?Math.round(npv/tgt*100):0;
  var barPct=Math.min(pct,120);
  document.getElementById('res-npv-val').textContent=inputs.bt>0?fmtEur(npv):'—';
  document.getElementById('res-tgt-lbl').textContent={{ ui.results.target_prefix|tojson }}+(inputs.bt>0?fmtEur(tgt):'—');
  var fill=document.getElementById('res-bar-fill');
  fill.style.width=barPct+'%';
  fill.style.background=pct>=100?'var(--green)':pct>=80?'var(--yellow)':'var(--red)';
  var verdict='';
  if(!inputs.bt){verdict={{ ui.results.verdict_no_data|tojson }};}
  else if(pct>=100){verdict={{ ui.results.verdict_reached|tojson }};}
  else if(pct>=80){verdict='{{ ui.results.verdict_almost_template|jsq }}'.replace('{pct}',pct);}
  else if(pct>=50){verdict='{{ ui.results.verdict_partway_template|jsq }}'.replace('{pct}',pct);}
  else{verdict='{{ ui.results.verdict_gap_template|jsq }}'.replace('{pct}',pct);}
  document.getElementById('res-verdict').innerHTML=verdict;
  document.getElementById('res-bar-lbl').textContent='{{ ui.results.bar_pct_template|jsq }}'.replace('{pct}',pct);

  // Parameter grid
  var pg=document.getElementById('param-grid'); pg.innerHTML='';
  var reds=[],yellows=[];
  Object.keys(PARAM_META).forEach(function(id){
    var score=oekScores[id], color=COLORS[id][score-1];
    var m=PARAM_META[id];
    var icon=color==='green'?'&#9989;':color==='yellow'?'&#9888;&#65039;':'&#10060;';
    var badgeCls='badge-'+color;
    var tip=PARAM_TIPS[id]?PARAM_TIPS[id][color]:'';
    var html='<div class="param-card">'
      +'<div class="param-head">'
      +'<span class="param-icon">'+m.icon+'</span>'
      +'<span class="param-name">'+m.name+'</span>'
      +'<span class="param-badge '+badgeCls+'">'+icon+' {{ ui.results.score_label|jsq }} '+score+'</span>'
      +'</div>'
      +'<div class="param-tip">'+tip+'</div>'
      +'</div>';
    pg.innerHTML+=html;
    if(color==='red') reds.push({id:id,score:score,name:m.name,tip:PARAM_TIPS[id].red});
    else if(color==='yellow') yellows.push({id:id,score:score,name:m.name,tip:PARAM_TIPS[id].yellow});
  });

  // Qualitative result
  var legalScore=qualScores.Ag+qualScores.Al+qualScores.Ab+qualScores.Ac;
  var stratScore=qualScores.Ec+qualScores.Es;
  var legalStatus=legalScore>=10?{icon:'&#9989;',color:'#16a34a',label:{{ ui.results.legal_status_strong|tojson }}}:legalScore>=7?{icon:'&#9888;&#65039;',color:'#d97706',label:{{ ui.results.legal_status_adequate|tojson }}}:{icon:'&#10060;',color:'#dc2626',label:{{ ui.results.legal_status_needs_attention|tojson }}};
  var stratStatus=stratScore>=5?{icon:'&#9989;',color:'#16a34a',label:{{ ui.results.strat_status_well_aligned|tojson }}}:stratScore>=4?{icon:'&#9888;&#65039;',color:'#d97706',label:{{ ui.results.strat_status_partial|tojson }}}:{icon:'&#10060;',color:'#dc2626',label:{{ ui.results.strat_status_missing|tojson }}};
  var legalRec=legalScore<7?{{ ui.results.legal_rec_low|tojson }}:legalScore<10?{{ ui.results.legal_rec_mid|tojson }}:{{ ui.results.legal_rec_high|tojson }};
  var stratRec=stratScore<4?{{ ui.results.strat_rec_low|tojson }}:stratScore<5?{{ ui.results.strat_rec_mid|tojson }}:{{ ui.results.strat_rec_high|tojson }};
  document.getElementById('qual-result').innerHTML='<h3>{{ ui.results.legal_strategic_title|jsq }}</h3>'
    +'<div class="qual-row"><div class="qual-dot" style="background:'+legalStatus.color+'"></div><div><strong>{{ ui.results.legal_protection_prefix|jsq }}'+legalStatus.icon+' '+legalStatus.label+'</strong><br>'+legalRec+'</div></div>'
    +'<div class="qual-row"><div class="qual-dot" style="background:'+stratStatus.color+'"></div><div><strong>{{ ui.results.strategic_alignment_prefix|jsq }}'+stratStatus.icon+' '+stratStatus.label+'</strong><br>'+stratRec+'</div></div>';

  // Actions
  var actions=[].concat(reds,yellows).slice(0,4);
  var al=document.getElementById('actions-list');
  if(actions.length===0){
    al.innerHTML='<div class="action-item"><div class="action-num">&#10003;</div><div class="action-text">{{ ui.results.actions_all_green|jsq }}</div></div>';
  } else {
    al.innerHTML=actions.map(function(a,i){
      return '<div class="action-item"><div class="action-num">'+(i+1)+'</div><div class="action-text"><strong>'+a.name+'</strong> {{ ui.results.action_score_template|jsq }}'.replace('{score}',a.score)+a.tip+'</div></div>';
    }).join('');
  }

  updateNPVBar();
}

function fillDemo(){
  document.getElementById('s_bt').value={{ demo.inputs.bt|jsq }};
  document.getElementById('s_tpct').value={{ demo.inputs.targetPct|jsq }};
  document.getElementById('s_sector').value={{ demo.inputs.sectorShare|jsq }};
  document.getElementById('s_costs').value={{ demo.inputs.costRatio|jsq }};
  document.getElementById('s_discount').value={{ demo.inputs.r|jsq }};
  document.getElementById('s_deprecpct').value={{ demo.inputs.deprecPct|jsq }};
  document.getElementById('s_deprecperiod').value={{ demo.inputs.deprecPeriod|jsq }};
  readSetup();
  var ds={{ demo.oekScores|tojson }};
  Object.keys(ds).forEach(function(id){selectOEK(id,ds[id]);});
  var dq={{ demo.qualScores|tojson }};
  Object.keys(dq).forEach(function(id){selectQual(id,dq[id]);});
  updateNPVBar();
  alert({{ demo.alert_text|tojson }});
}

document.addEventListener('DOMContentLoaded',function(){
  buildPages();
  buildStepBar();
  updateNavInfo();
  updateNPVBar();
  // init all OEK selections to default score 3
  Object.keys(oekScores).forEach(function(id){selectOEK(id,oekScores[id]);});
  Object.keys(qualScores).forEach(function(id){selectQual(id,qualScores[id]);});
});
</script>
