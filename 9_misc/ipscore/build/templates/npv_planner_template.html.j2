        <div style="font-size:.73rem;color:#64748b;margin-top:6px">{{ ui.page0.sector_note|jsq }}</div>
      </div>
      <div class="setup-field">
        <label>{{ ui.page0.costs_label|jsq }} <span class="hint">{{ ui.page0.costs_hint|jsq }}</span></label>
        <input class="setup-input" type="number" id="s_costs" value="73" min="1" max="99" oninput="readSetup();updateNPVBar()">
        <div style="font-size:.73rem;color:#64748b;margin-top:6px">{{ ui.page0.costs_note|jsq }}</div>
      </div>
      <div class="setup-field">
        <label>{{ ui.page0.discount_label|jsq }} <span class="hint">{{ ui.page0.discount_hint|jsq }}</span></label>
        <input class="setup-input" type="number" id="s_discount" value="11" min="1" max="30" oninput="readSetup();updateNPVBar()">
        <div style="font-size:.73rem;color:#64748b;margin-top:6px">{{ ui.page0.discount_note|jsq }}</div>
      </div>
    </div>
    <button class="adv-toggle" onclick="document.getElementById('adv').classList.toggle('open');this.textContent=document.getElementById('adv').classList.contains('open')?{{ ui.page0.adv_toggle_hide|tojson }}:{{ ui.page0.adv_toggle_open|tojson }}">{{ ui.page0.adv_toggle_open|jsq }}</button>
    <div id="adv" class="adv-section">
      <div class="setup-field">
        <label>{{ ui.page0.deprecpct_label|jsq }} <span class="hint">{{ ui.page0.deprecpct_hint|jsq }}</span></label>
        <input class="setup-input" type="number" id="s_deprecpct" value="2.5" step="0.1" oninput="readSetup();updateNPVBar()">
      </div>
      <div class="setup-field">
        <label>{{ ui.page0.deprecperiod_label|jsq }} <span class="hint">{{ ui.page0.deprecperiod_hint|jsq }}</span></label>
        <input class="setup-input" type="number" id="s_deprecperiod" value="8" oninput="readSetup();updateNPVBar()">
      </div>
    </div>
    <br>
    <button class="demo-btn" onclick="fillDemo()">{{ ui.page0.demo_btn|jsq }}</button>
  `;
  pagesDiv.appendChild(p0);

  // PAGE 1 — Technology (B5 only, high emphasis)
  var p1=document.createElement('div');
  p1.className='page'; p1.id='page-1';
  p1.innerHTML=`
    <div class="page-title">{{ ui.page1.title|jsq }}</div>
    <div class="page-desc">{{ ui.page1.desc|jsq }}</div>
    ${OEK_CARDS.filter(function(c){return ['B5'].indexOf(c.id)>=0;}).map(function(c){return oekCard(c.id,c.icon,c.title,c.question,c.context,c.opts);}).join('')}
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:16px;font-size:.82rem;color:#1e3a8a;line-height:1.6">
      {{ ui.page1.why_box|jsq }}
    </div>
  `;
  pagesDiv.appendChild(p1);

  // PAGE 2 — Market (C2, C3, C6)
  var p2=document.createElement('div');
  p2.className='page'; p2.id='page-2';
  p2.innerHTML=`
    <div class="page-title">{{ ui.page2.title|jsq }}</div>
    <div class="page-desc">{{ ui.page2.desc|jsq }}</div>
    ${OEK_CARDS.filter(function(c){return ['C2','C3','C6'].indexOf(c.id)>=0;}).map(function(c){return oekCard(c.id,c.icon,c.title,c.question,c.context,c.opts);}).join('')}
  `;
  pagesDiv.appendChild(p2);

  // PAGE 3 — Finance (D1, D2, D3, D4)
  var p3=document.createElement('div');
  p3.className='page'; p3.id='page-3';
  p3.innerHTML=`
    <div class="page-title">{{ ui.page3.title|jsq }}</div>
    <div class="page-desc">{{ ui.page3.desc|jsq }}</div>
    ${OEK_CARDS.filter(function(c){return ['D1','D2','D3','D4'].indexOf(c.id)>=0;}).map(function(c){return oekCard(c.id,c.icon,c.title,c.question,c.context,c.opts);}).join('')}
  `;
  pagesDiv.appendChild(p3);

  // PAGE 4 — Legal & Strategy
  var p4=document.createElement('div');
  p4.className='page'; p4.id='page-4';
  p4.innerHTML=`
    <div class="page-title">{{ ui.page4.title|jsq }}</div>
    <div class="page-desc">{{ ui.page4.desc|jsq }}</div>
    <div style="font-size:.82rem;color:#475569;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px 16px;margin-bottom:18px">
      {{ ui.page4.note|jsq }}
    </div>
    ${QUAL_QUESTIONS.map(function(q){return qualCard(q.id,q.t,q.opts);}).join('')}
  `;
  pagesDiv.appendChild(p4);

  // PAGE 5 — Results
  var p5=document.createElement('div');
  p5.className='page'; p5.id='page-5';
  p5.innerHTML=`
    <div class="page-title">{{ ui.page5.title|jsq }}</div>
    <div class="page-desc">{{ ui.page5.desc|jsq }}</div>
    <div class="res-hero" id="res-hero">
      <div class="res-npv">
        <div class="res-npv-val" id="res-npv-val">—</div>
        <div class="res-npv-lbl">{{ ui.page5.estimated_npv_label|jsq }}</div>
        <div style="font-size:.78rem;margin-top:6px;opacity:.75" id="res-tgt-lbl">{{ ui.page5.target_prefix|jsq }}—</div>
      </div>
      <div class="res-bar-wrap">
        <div class="res-bar-lbl" id="res-bar-lbl">{{ ui.page5.progress_label|jsq }}</div>
        <div class="res-bar-track"><div class="res-bar-fill" id="res-bar-fill" style="width:0%"></div></div>
        <div class="res-verdict" id="res-verdict">{{ ui.page5.verdict_placeholder|jsq }}</div>
      </div>
    </div>
