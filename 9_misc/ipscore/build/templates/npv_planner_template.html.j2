<!DOCTYPE html>
<html lang="{{ ui.html_lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{{ ui.title }}</title>
<style>
:root{--navy:#1a2744;--blue:#2563eb;--orange:#f97316;--border:#e2e8f0;--green:#16a34a;--red:#dc2626;--yellow:#d97706}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Arial,sans-serif;background:#f1f5f9;color:#1e293b;min-height:100vh}
header{background:var(--navy);color:#fff;padding:12px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.3)}
header .brand{font-size:1.1rem;font-weight:700}
header .sub{font-size:.75rem;opacity:.7;margin-top:2px}
header .badge{background:#f59e0b;color:#fff;font-size:.68rem;font-weight:700;padding:3px 10px;border-radius:20px}
.step-bar{background:#fff;border-bottom:1px solid var(--border);padding:10px 28px;display:flex;align-items:center;gap:6px;overflow-x:auto}
.step{display:flex;align-items:center;gap:6px;flex-shrink:0}
.step-dot{width:28px;height:28px;border-radius:50%;border:2px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;color:#94a3b8;cursor:pointer;transition:all .2s}
.step-dot.active{background:var(--blue);border-color:var(--blue);color:#fff}
.step-dot.done{background:var(--navy);border-color:var(--navy);color:#fff}
.step-label{font-size:.68rem;color:#64748b;white-space:nowrap}
.step-sep{width:20px;height:2px;background:var(--border);flex-shrink:0}
.step-sep.done{background:var(--navy)}
.npv-bar{background:#1e293b;color:#fff;padding:8px 28px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:.82rem}
.npv-bar .lbl{color:#94a3b8}
.npv-live{font-size:1.15rem;font-weight:800;color:var(--orange)}
.npv-tgt{font-weight:600;color:#cbd5e1}
.npv-gap{padding:3px 12px;border-radius:12px;font-weight:700;font-size:.76rem}
.gap-ok{background:var(--green)}
.gap-warn{background:var(--yellow)}
.gap-bad{background:var(--red)}
.gap-none{background:#475569}
.page{display:none;padding:24px 28px 100px;max-width:880px;margin:0 auto}
.page.active{display:block}
.page-title{font-size:1.3rem;font-weight:800;color:var(--navy);margin-bottom:4px}
.page-desc{font-size:.88rem;color:#475569;margin-bottom:24px;line-height:1.6}
.setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:600px){.setup-grid{grid-template-columns:1fr}}
.setup-field{background:#fff;border:1px solid var(--border);border-radius:8px;padding:14px 16px}
.setup-field label{display:block;font-size:.78rem;font-weight:700;color:var(--navy);margin-bottom:6px}
.setup-field .hint{font-size:.71rem;color:#64748b;font-weight:400;margin-left:4px}
.setup-input{width:100%;border:1.5px solid var(--border);border-radius:6px;padding:8px 12px;font-size:.92rem;color:#1e293b;transition:border-color .15s}
.setup-input:focus{outline:none;border-color:var(--blue)}
.adv-toggle{font-size:.78rem;color:var(--blue);cursor:pointer;margin-top:16px;display:inline-flex;align-items:center;gap:4px;background:none;border:none;padding:0}
.adv-section{display:none;margin-top:12px}
.adv-section.open{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.demo-btn{background:var(--orange);color:#fff;border:none;border-radius:8px;padding:10px 22px;font-size:.88rem;font-weight:700;cursor:pointer;margin-top:20px;transition:background .15s}
.demo-btn:hover{background:#ea580c}
.oek-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:22px;margin-bottom:20px;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.oek-card-header{display:flex;align-items:flex-start;gap:12px;margin-bottom:8px}
.oek-icon{font-size:1.6rem;flex-shrink:0;margin-top:2px}
.oek-title{font-size:1.05rem;font-weight:800;color:var(--navy)}
.oek-question{font-size:.88rem;color:#475569;margin-top:3px;line-height:1.5}
.oek-context{font-size:.8rem;color:#64748b;background:#f8fafc;border-left:3px solid var(--blue);padding:8px 12px;border-radius:0 6px 6px 0;margin-bottom:14px;line-height:1.5}
.opt-row{display:flex;flex-direction:column;gap:8px}
.opt-item{border:2px solid var(--border);border-radius:8px;padding:11px 14px;cursor:pointer;display:flex;align-items:flex-start;gap:12px;transition:all .15s}
.opt-item:hover{border-color:#93c5fd;background:#f0f6ff}
.opt-item.sel-green{border-color:var(--green);background:#f0fdf4}
.opt-item.sel-yellow{border-color:var(--yellow);background:#fffbeb}
.opt-item.sel-red{border-color:var(--red);background:#fef2f2}
.opt-dot{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;color:#fff;flex-shrink:0;margin-top:1px}
.dot-green{background:var(--green)}
.dot-yellow{background:var(--yellow)}
.dot-red{background:var(--red)}
.opt-label{font-size:.88rem;font-weight:700;color:var(--navy)}
.opt-desc{font-size:.78rem;color:#64748b;margin-top:2px;line-height:1.4}
.oek-insight{display:none;margin-top:12px;padding:12px 16px;border-radius:8px;font-size:.82rem;line-height:1.6}
.insight-green{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534}
.insight-yellow{background:#fffbeb;border:1px solid #fde68a;color:#92400e}
.insight-red{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
.qual-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:14px}
.qual-q{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:12px}
.qual-opts{display:flex;flex-direction:column;gap:7px}
.qual-opt{border:2px solid var(--border);border-radius:7px;padding:10px 14px;cursor:pointer;font-size:.83rem;color:#374151;transition:all .15s;display:flex;align-items:center;gap:10px}
.qual-opt:hover{border-color:#93c5fd;background:#f0f6ff}
.qual-opt.qual-sel{border-color:var(--blue);background:#eff6ff;color:var(--navy);font-weight:600}
.qual-num{width:22px;height:22px;border-radius:50%;background:var(--border);color:#64748b;font-size:.7rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.qual-sel .qual-num{background:var(--blue);color:#fff}
.nav-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);padding:12px 28px;display:flex;justify-content:space-between;align-items:center;z-index:90}
.nav-info{font-size:.8rem;color:#64748b;font-weight:600}
.btn{padding:9px 24px;border-radius:8px;font-size:.88rem;font-weight:700;cursor:pointer;border:none;transition:all .15s}
.btn-prev{background:#f1f5f9;color:var(--navy);border:1.5px solid var(--border)}
.btn-prev:hover{background:#e2e8f0}
.btn-next{background:var(--blue);color:#fff}
.btn-next:hover{background:#1d4ed8}
.btn-print{background:var(--orange);color:#fff}
.btn-print:hover{background:#ea580c}
.res-hero{background:linear-gradient(135deg,var(--navy),#2d4a8a);color:#fff;border-radius:12px;padding:26px;margin-bottom:20px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.res-npv{text-align:center}
.res-npv-val{font-size:2.4rem;font-weight:800;color:var(--orange);line-height:1}
.res-npv-lbl{font-size:.78rem;opacity:.75;margin-top:4px}
.res-bar-wrap{flex:1;min-width:200px}
.res-bar-lbl{font-size:.8rem;opacity:.8;margin-bottom:6px}
.res-bar-track{height:20px;background:rgba(255,255,255,.15);border-radius:10px;overflow:hidden}
.res-bar-fill{height:20px;border-radius:10px;transition:width .5s;background:var(--orange)}
.res-verdict{font-size:.85rem;margin-top:10px;background:rgba(255,255,255,.1);border-radius:8px;padding:10px 14px;line-height:1.5}
.param-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
@media(max-width:600px){.param-grid{grid-template-columns:1fr}}
.param-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:14px}
.param-head{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.param-icon{font-size:1rem}
.param-name{font-size:.82rem;font-weight:700;color:var(--navy);flex:1}
.param-badge{font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:10px;color:#fff}
.badge-green{background:var(--green)}
.badge-yellow{background:var(--yellow)}
.badge-red{background:var(--red)}
.param-tip{font-size:.76rem;color:#475569;line-height:1.45}
.qual-result-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:20px}
.qual-result-card h3{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:12px}
.qual-row{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;font-size:.8rem;color:#374151;line-height:1.45}
.qual-dot{width:16px;height:16px;border-radius:50%;flex-shrink:0;margin-top:2px}
.actions-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:20px}
.actions-card h3{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:12px}
.action-item{display:flex;gap:10px;margin-bottom:10px;align-items:flex-start}
.action-num{width:24px;height:24px;border-radius:50%;background:var(--orange);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.action-text{font-size:.82rem;color:#374151;line-height:1.5}
@media print{header,.step-bar,.npv-bar,.nav-bar{display:none!important}.page{display:block!important;padding:10px}body{background:#fff}}
</style>
</head>
<body>
<header>
  <div>
    <div class="brand">{{ ui.brand }}</div>
    <div class="sub">{{ ui.sub }}</div>
  </div>
  <div class="badge">{{ ui.badge }}</div>
</header>
<div class="step-bar" id="step-bar"></div>
<div class="npv-bar" id="npv-bar">
  <span class="lbl">{{ ui.npv_bar.estimated_label }}</span>
  <span class="npv-live" id="npv-live">—</span>
  <span class="lbl">{{ ui.npv_bar.target_label }}</span>
  <span class="npv-tgt" id="npv-tgt">{{ ui.npv_bar.target_placeholder }}</span>
  <span class="npv-gap gap-none" id="npv-gap">{{ ui.npv_bar.gap_placeholder }}</span>
</div>
<div id="pages"></div>
<div class="nav-bar">
  <button class="btn btn-prev" id="btn-prev" onclick="navigate(-1)">&#8592; {{ ui.nav_prev }}</button>
  <div class="nav-info" id="nav-info"></div>
  <button class="btn btn-next" id="btn-next" onclick="navigate(1)">{{ ui.nav_next }} &#8594;</button>
</div>
<script>
var cur = 0, NPAGE = 6;
var inputs = {bt:0, targetPct:15, sectorShare:30, costRatio:73, r:11, deprecPct:2.5, deprecPeriod:8};
var oekScores = {B5:3, C2:3, C3:3, C6:3, D1:3, D2:3, D3:3, D4:3};
var qualScores = {Ag:1, Al:1, Ab:1, Ac:1, Ec:1, Es:1};
var COLORS = {
  B5:['red','red','yellow','green','green'],
  C2:['red','red','yellow','green','green'],
  C3:['red','red','yellow','green','green'],
  C6:['red','red','yellow','green','green'],
  D1:['red','red','yellow','green','green'],
  D2:['red','red','yellow','green','green'],
  D3:['red','red','yellow','green','green'],
  D4:['red','red','yellow','green','green']
};
var OEK_VALUES = {
  B5:[5,2,1,0.5,0], C2:[0.005,0.025,0.05,0.08,0.15], C3:[0.5,1,2,4,8],
  C6:[0.005,0.02,0.04,0.06,0.1], D1:[1,0.75,0.5,0.25,0], D2:[0.3,0.15,0.08,0.025,0.005],
  D3:[1.3,1.15,1.0,0.85,0.7], D4:[1.2,1.1,1.0,0.7,0.5]
};
var OEK_CARDS = {{ oek_cards_json }};
var QUAL_QUESTIONS = {{ qual_questions_json }};

var INSIGHTS = {{ insights_json }};


var PARAM_META = {{ param_meta_json }};


function fmtEur(n){
  if(!n&&n!==0) return '—';
  return n.toLocaleString('{{ ui.locale|jsq }}',{style:'currency',currency:'EUR',maximumFractionDigits:0});
}

function readSetup(){
  var g = function(id){return parseFloat(document.getElementById(id).value)||0;};
  inputs.bt = g('s_bt');
  inputs.targetPct = g('s_tpct')||15;
  inputs.sectorShare = g('s_sector')||30;
  inputs.costRatio = g('s_costs')||73;
  inputs.r = g('s_discount')||11;
  inputs.deprecPct = g('s_deprecpct')||2.5;
  inputs.deprecPeriod = g('s_deprecperiod')||8;
}

function calcNPV(){
  if(!inputs.bt||!inputs.sectorShare) return 0;
  var BT=inputs.bt, S=inputs.sectorShare/100, shareCosts=inputs.costRatio/100;
  var r=inputs.r/100, depPeriod=inputs.deprecPeriod;
  var shareDeprec_pct=inputs.deprecPct, invIndex=depPeriod*inputs.deprecPct/100;
  var T=OEK_VALUES.B5[oekScores.B5-1], g=OEK_VALUES.C2[oekScores.C2-1];
  var L=OEK_VALUES.C3[oekScores.C3-1], et=OEK_VALUES.C6[oekScores.C6-1];
  var D1=OEK_VALUES.D1[oekScores.D1-1], D2=OEK_VALUES.D2[oekScores.D2-1];
  var D3=OEK_VALUES.D3[oekScores.D3-1], D4=OEK_VALUES.D4[oekScores.D4-1];
  function frac(y){
    if(y<=T) return 0;
    if(y-T<1) return y-T;
    if(y<=T+L) return 1;
    if(y-T-L<1) return 1-(y-T-L);
    return 0;
  }
  var rev=[0];
  for(var y=1;y<=10;y++) rev.push(frac(y)*et*Math.pow(1+g,y-1)*S*Math.pow(1+g,y)*100);
  var yFirst=0;
  for(var y=1;y<=10;y++){if(rev[y]>0){yFirst=y;break;}}
  // Matches Excel 'Financial calculations' rows 98-121: sum revenue over every
  // year y with y>T and y<=T+1+depPeriod (always depPeriod+1 calendar-year
  // slots, not depPeriod), then divide by depPeriod.
  var sumR=0;
  for(var y=1;y<=10;y++){ if(y>T && y<=T+1+depPeriod) sumR+=rev[y]; }
  var avgRev=depPeriod>0?sumR/depPeriod:0;
  var van=0;
  for(var y=1;y<=10;y++){
    var rv=rev[y], fr=frac(y);
    var devCost=(y<=T)?D2*S*100:0;
    var costs=rv*D3*shareCosts+devCost;
    var invest=(y===yFirst&&yFirst>0)?avgRev*D4*invIndex:0;
    var invRed=(y===yFirst&&yFirst>0)?depPeriod*shareDeprec_pct*(1-D4)*S*Math.pow(1+g,y):0;
    var reg=fr*(1-shareCosts)*(1-D1)*S*Math.pow(1+g,y)*100;
    var eff=fr*shareCosts*(1-D3)*S*Math.pow(1+g,y)*100;
    van+=(rv-costs-invest+reg+eff+invRed)*BT/100/Math.pow(1+r,y);
  }
  return van;
}

function updateNPVBar(){
  var npv=calcNPV();
  var tgt=inputs.bt>0?(inputs.bt*inputs.targetPct/100):0;
  document.getElementById('npv-live').textContent=inputs.bt>0?fmtEur(npv):'—';
  document.getElementById('npv-tgt').textContent=inputs.bt>0?fmtEur(tgt):{{ ui.npv_bar.target_placeholder|tojson }};
  var gap=document.getElementById('npv-gap');
  if(!inputs.bt){gap.textContent={{ ui.npv_bar.gap_placeholder|tojson }}; gap.className='npv-gap gap-none'; return;}
  var pct=tgt>0?Math.round(npv/tgt*100):0;
  if(npv>=tgt){gap.textContent={{ ui.npv_bar.gap_reached|tojson }};gap.className='npv-gap gap-ok';}
  else if(pct>=80){gap.textContent='{{ ui.npv_bar.gap_warn_template|jsq }}'.replace('{pct}',pct);gap.className='npv-gap gap-warn';}
  else{gap.textContent='{{ ui.npv_bar.gap_bad_template|jsq }}'.replace('{pct}',pct);gap.className='npv-gap gap-bad';}
}

function selectOEK(id, score){
  oekScores[id]=score;
  for(var s=1;s<=5;s++){
    var el=document.getElementById('opt-'+id+'-'+s);
    if(!el) continue;
    el.className='opt-item'+(s===score?' sel-'+COLORS[id][s-1]:'');
  }
  var ins=document.getElementById('insight-'+id);
  if(ins&&INSIGHTS[id]&&INSIGHTS[id][score]){
    ins.className='oek-insight insight-'+COLORS[id][score-1];
    ins.innerHTML=INSIGHTS[id][score];
    ins.style.display='block';
  }
  updateNPVBar();
}

function selectQual(id, score){
  qualScores[id]=score;
  for(var s=1;s<=3;s++){
    var el=document.getElementById('qopt-'+id+'-'+s);
    if(el) el.classList.toggle('qual-sel', s===score);
  }
}

function navigate(dir){
  if(cur===0) readSetup();
  var pages=document.querySelectorAll('.page');
  var dots=document.querySelectorAll('.step-dot');
  var seps=document.querySelectorAll('.step-sep');
  pages[cur].classList.remove('active');
  dots[cur].classList.remove('active'); dots[cur].classList.add('done');
  if(seps[cur]) seps[cur].classList.add('done');
  cur=Math.max(0,Math.min(NPAGE-1,cur+dir));
  pages[cur].classList.add('active');
  dots[cur].classList.remove('done'); dots[cur].classList.add('active');
  updateNavInfo();
  if(cur===NPAGE-1) updateResults();
  window.scrollTo(0,0);
}

function goToPage(p){
  if(p<0||p>=NPAGE) return;
  if(cur===0) readSetup();
  document.querySelectorAll('.page')[cur].classList.remove('active');
  document.querySelectorAll('.step-dot')[cur].classList.remove('active');
  cur=p;
  document.querySelectorAll('.page')[cur].classList.add('active');
  document.querySelectorAll('.step-dot')[cur].classList.remove('done');
  document.querySelectorAll('.step-dot')[cur].classList.add('active');
  updateNavInfo();
  if(cur===NPAGE-1) updateResults();
  window.scrollTo(0,0);
}

function updateNavInfo(){
  var names={{ ui.nav_page_names|tojson }};
  document.getElementById('nav-info').textContent={{ ui.nav_step_label|tojson }}+' '+(cur+1)+' '+{{ ui.nav_of_label|tojson }}+' '+NPAGE+' — '+names[cur];
  document.getElementById('btn-prev').style.display=cur===0?'none':'';
  if(cur===NPAGE-1){
    document.getElementById('btn-next').style.display='none';
    if(!document.getElementById('btn-print2')){
      var pb=document.createElement('button');
      pb.className='btn btn-print'; pb.id='btn-print2';
      pb.innerHTML={{ ui.print_btn2_text|tojson }}; pb.onclick=function(){window.print();};
      document.querySelector('.nav-bar').appendChild(pb);
    }
  } else {
    document.getElementById('btn-next').style.display='';
    var pb2=document.getElementById('btn-print2'); if(pb2) pb2.remove();
  }
}

function buildStepBar(){
  var bar=document.getElementById('step-bar');
  var names={{ ui.step_bar_names|tojson }};
  var html='';
  for(var i=0;i<NPAGE;i++){
    if(i>0) html+='<div class="step-sep" id="sep-'+(i-1)+'"></div>';
    html+='<div class="step"><div class="step-dot'+(i===0?' active':'')
      +'" id="dot-'+i+'" onclick="goToPage('+i+')">'+(i+1)+'</div>'
      +'<span class="step-label">'+names[i]+'</span></div>';
  }
  bar.innerHTML=html;
}

function oekCard(id, icon, title, question, context, opts){
  var rows=opts.map(function(opt,i){
    var s=i+1, c=COLORS[id][i];
    return `<div class="opt-item" id="opt-${id}-${s}" onclick="selectOEK('${id}',${s})">
      <div class="opt-dot dot-${c}">${s}</div>
      <div><div class="opt-label">${opt.label}</div><div class="opt-desc">${opt.desc}</div></div>
    </div>`;
  }).join('');
  return `<div class="oek-card">
    <div class="oek-card-header">
      <div class="oek-icon">${icon}</div>
      <div><div class="oek-title">${title}</div><div class="oek-question">${question}</div></div>
    </div>
    <div class="oek-context">${context}</div>
    <div class="opt-row">${rows}</div>
    <div class="oek-insight" id="insight-${id}"></div>
  </div>`;
}

function qualCard(id, question, opts){
  var rows=opts.map(function(opt,i){
    var s=i+1;
    return `<div class="qual-opt" id="qopt-${id}-${s}" onclick="selectQual('${id}',${s})">
      <div class="qual-num">${s}</div>${opt}
    </div>`;
  }).join('');
  return `<div class="qual-card"><div class="qual-q">${question}</div><div class="qual-opts">${rows}</div></div>`;
}

function buildPages(){
  var pagesDiv=document.getElementById('pages');
  pagesDiv.innerHTML='';

  // PAGE 0 — Setup
  var p0=document.createElement('div');
  p0.className='page active'; p0.id='page-0';
  p0.innerHTML=`
    <div class="page-title">{{ ui.page0.title|jsq }}</div>
    <div class="page-desc">{{ ui.page0.desc|jsq }}</div>
    <div class="setup-grid">
      <div class="setup-field" style="grid-column:span 2">
        <label>{{ ui.page0.bt_label|jsq }} <span class="hint">{{ ui.page0.bt_hint|jsq }}</span></label>
        <input class="setup-input" type="number" id="s_bt" placeholder="{{ ui.page0.bt_placeholder|jsq }}" oninput="readSetup();updateNPVBar()">
      </div>
      <div class="setup-field">
